# Copy this file to .env.local and fill in your Supabase project's values.
# Find these at: supabase.com/dashboard -> your project -> Settings -> API
#
# NEXT_PUBLIC_SUPABASE_URL is the "Project URL".
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "anon public" key — NOT the service_role key.
# Both are safe to expose in client-side code (the "anon" key is designed for
# this). The service_role key must never be given a NEXT_PUBLIC_ name or read
# from a component — it bypasses every security rule. There is exactly one
# exception, at the bottom of this file: server-side code that reaches the
# locked-down Zalo token table, which the browser never runs.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Zalo booking confirmations (optional) ----------
# Leave these blank and the app behaves exactly as it does now — the send is
# skipped, and nothing in the booking flow changes.
#
# None of these carry the NEXT_PUBLIC_ prefix, deliberately: the app secret is
# also the webhook signing key, and anything NEXT_PUBLIC_ is compiled into the
# JavaScript every guest downloads.
ZALO_APP_ID=
ZALO_APP_SECRET=

# The callback URL, registered byte-for-byte in the Zalo console under
# Login -> Add Platform -> Web. Usually must be a real https domain, not
# localhost, so register the deployed URL.
ZALO_REDIRECT_URI=

# Optional. Zalo returns the OA id when you approve the app, and it is stored
# then — set this only to refuse a connection to any other Official Account.
ZALO_OA_ID=

# Only needed for guest booking confirmations, not for group alerts.
ZALO_BOOKING_TEMPLATE_ID=

# "true" routes sends to Zalo's development wallet, which only delivers to OA
# administrators. Use it for the first test so you can't message a real guest.
ZALO_DEVELOPMENT_MODE=

# Server-only Supabase key, used solely to reach the locked-down Zalo token
# table. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Alerts on staff phones (Web Push) ----------
# Generate once with: npx web-push generate-vapid-keys
# Changing these later unsubscribes every device, so keep them.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ---------- Zalo staff group (optional) ----------
# Only a group CREATED BY your Official Account can be posted to; an existing
# staff group cannot. Needs the Zalo credentials above as well.
ZALO_GROUP_ID=
